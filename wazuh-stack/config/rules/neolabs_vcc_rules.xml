<!--
  NeoLabs VCC synthetic telemetry rules.
  Custom rule IDs use Wazuh's recommended 100000-120000 range.
  These rules are intentionally limited to events marked synthetic and carrying
  the VCC schema fields expected by the pod-scoped collector.
-->
<group name="neolabs,vcc,synthetic_training,">

  <!--
    Level 3 is intentional. Week 1 is a baseline/log-literacy exercise, so every
    validated synthetic VCC event must reach wazuh-alerts-* and be searchable in
    Threat Hunting even when it is normal activity rather than a higher-severity
    security finding. More specific child rules below raise the severity.
  -->
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="synthetic" type="pcre2">^true$</field>
    <field name="schema_version" type="pcre2">^1\.</field>
    <field name="pod_id" type="pcre2">^pod-[0-9]{2}$</field>
    <description>NeoLabs VCC: Validated synthetic pod telemetry event.</description>
    <group>vcc_baseline,</group>
    <options>no_full_log</options>
  </rule>

  <rule id="100110" level="5">
    <if_sid>100100</if_sid>
    <!-- Current VCC schema emits authentication.login; keep the legacy value readable for older replay packs. -->
    <field name="event_type" type="pcre2">^(authentication|authentication\.login)$</field>
    <field name="outcome" type="pcre2">^failure$</field>
    <description>NeoLabs VCC: Authentication failure for $(synthetic_username) [$(synthetic_user_id)] from $(source_ip).</description>
    <group>authentication_failed,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100111" level="9" frequency="5" timeframe="300">
    <if_matched_sid>100110</if_matched_sid>
    <same_field>synthetic_user_id</same_field>
    <description>NeoLabs VCC: Repeated authentication failures for the same account within five minutes.</description>
    <group>authentication_failures,credential_access,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100112" level="8" frequency="5" timeframe="300">
    <if_matched_sid>100110</if_matched_sid>
    <same_field>source_ip</same_field>
    <description>NeoLabs VCC: One source generated repeated authentication failures within five minutes.</description>
    <group>authentication_failures,credential_access,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100120" level="3">
    <if_sid>100100</if_sid>
    <!-- Current VCC schema emits authentication.login; keep the legacy value readable for older replay packs. -->
    <field name="event_type" type="pcre2">^(authentication|authentication\.login)$</field>
    <field name="outcome" type="pcre2">^success$</field>
    <description>NeoLabs VCC: Successful authentication for $(synthetic_username) [$(synthetic_user_id)] from $(source_ip).</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100121" level="10" frequency="2" timeframe="900">
    <if_matched_sid>100110</if_matched_sid>
    <field name="event_type" type="pcre2">^(authentication|authentication\.login)$</field>
    <field name="outcome" type="pcre2">^success$</field>
    <same_field>synthetic_user_id</same_field>
    <description>NeoLabs VCC: Authentication success followed earlier failures for the same account.</description>
    <group>authentication_success_after_failures,credential_access,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100122" level="12">
    <if_sid>100100</if_sid>
    <field name="event_type" type="pcre2">^identity\.account_hijacked$</field>
    <field name="synthetic_user_id" type="pcre2">^syn-credential-storm-pod-01-(?:0[1-9]|1[0-5])$</field>
    <field name="outcome" type="pcre2">^success$</field>
    <description>NeoLabs VCC: Week 3 account hijack confirmed for $(synthetic_username) [$(synthetic_user_id)] from $(source_ip).</description>
    <group>authentication_success,account_hijack,credential_access,w03_credential_storm,</group>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <rule id="100130" level="7">
    <if_sid>100100</if_sid>
    <field name="event_type" type="pcre2">^account_change(?:\..+)?$</field>
    <!-- `action` is a Wazuh static field, so it must use the dedicated rule tag. -->
    <action type="pcre2">^(password_reset|email_change|mfa_change|role_change)$</action>
    <field name="outcome" type="pcre2">^success$</field>
    <description>NeoLabs VCC: Sensitive account change completed.</description>
    <group>account_change,identity,</group>
  </rule>

  <rule id="100140" level="8">
    <if_sid>100100</if_sid>
    <field name="event_type" type="pcre2">^(authorization|authorization\.access)$</field>
    <field name="outcome" type="pcre2">^(denied|failure)$</field>
    <description>NeoLabs VCC: Authorization request was denied by a protected access-control decision.</description>
    <group>authorization_denied,access_control,</group>
  </rule>

  <rule id="100150" level="9">
    <if_sid>100100</if_sid>
    <field name="event_type" type="pcre2">^telemetry_health(?:\..+)?$</field>
    <!-- `status` is also a Wazuh static field. -->
    <status type="pcre2">^(disconnected|parser_failure|schema_rejected|clock_skew|duplicate_ingestion)$</status>
    <description>NeoLabs VCC: Telemetry quality or availability problem detected.</description>
    <group>telemetry_health,visibility_gap,</group>
  </rule>

  <rule id="100160" level="12">
    <if_sid>100100</if_sid>
    <field name="event_type" type="pcre2">^network\.ip_watchlist_match$</field>
    <field name="event_action" type="pcre2">^ip_watchlist_match$</field>
    <field name="outcome" type="pcre2">^match$</field>
    <description>NeoLabs VCC: Watched source IP $(source_ip) made an HTTPS request to $(metadata.path) (HTTP $(metadata.status)).</description>
    <group>network,ip_watchlist,w03_credential_storm,</group>
  </rule>

  <rule id="100170" level="3">
    <if_sid>100100</if_sid>
    <field name="event_type" type="pcre2">^network\.https_request$</field>
    <description>NeoLabs VCC: HTTPS $(metadata.method) request from $(source_ip) to $(metadata.path) returned $(metadata.status).</description>
    <group>network,https,w03_credential_storm,</group>
  </rule>

  <rule id="100180" level="3">
    <if_sid>100100</if_sid>
    <field name="event_type" type="pcre2">^host\.runtime_health$</field>
    <field name="outcome" type="pcre2">^healthy$</field>
    <description>NeoLabs VCC: Arena API runtime heartbeat; uptime $(metadata.process_uptime_seconds)s, RSS $(metadata.rss_megabytes) MB.</description>
    <group>host,system_health,w03_credential_storm,</group>
  </rule>

</group>
