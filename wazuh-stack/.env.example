# Copy to .env and replace every CHANGE_ME value before startup.
# Never commit .env.

# Tested NeoLabs baseline. Review release notes before changing.
WAZUH_VERSION=4.14.7
WAZUH_DOCKER_TAG=v4.14.7
WAZUH_DOCKER_COMMIT=adcc5b57d2f7edfcbe6c399272dc76fbdf12b623

WAZUH_INDEXER_PASSWORD=CHANGE_ME_GENERATE_STRONG_SECRET
WAZUH_API_PASSWORD=CHANGE_ME_GENERATE_STRONG_SECRET
WAZUH_DASHBOARD_PASSWORD=CHANGE_ME_GENERATE_STRONG_SECRET

# Local display label only. The VCC control plane determines effective pod scope.
POD_LABEL=UNENROLLED

# Populated by the enrolment client after successful operator-approved enrolment.
VCC_ENROLMENT_BASE_URL=
VCC_TELEMETRY_ENDPOINT=
VCC_CLIENT_CERT_PATH=./secrets/vcc/client.crt
VCC_CLIENT_KEY_PATH=./secrets/vcc/client.key
VCC_CA_CERT_PATH=./secrets/vcc/ca.crt
VCC_INSTALLATION_ID_PATH=./secrets/vcc/installation-id
VCC_TELEMETRY_CURSOR_PATH=./state/vcc-telemetry.cursor
VCC_POLL_INTERVAL_SECONDS=15

# Dashboard binding. Use loopback by default for a workstation deployment.
WAZUH_DASHBOARD_BIND=127.0.0.1
WAZUH_DASHBOARD_PORT=8443
