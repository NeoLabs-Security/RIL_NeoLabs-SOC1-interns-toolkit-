{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.neolabs.invalid/student-manifest.v2.json",
  "title": "NeoLabs Student Manifest v2",
  "type": "object",
  "required": ["schema_version", "protocol_version", "deployment_id", "deployment_channel", "scenario_id", "scenario_release", "release_generation", "student_ready", "lab_state", "runtime_mode", "pod_id", "track", "assignment_id", "resources"],
  "properties": {
    "schema_version": {"const": 2},
    "protocol_version": {"const": "2.0"},
    "deployment_id": {"type": "string", "minLength": 3},
    "deployment_channel": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "scenario_id": {"type": "string", "pattern": "^w[0-9]{2}-[a-z0-9-]+$"},
    "scenario_release": {"type": "string", "minLength": 1},
    "release_generation": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
    "student_ready": {"const": true},
    "lab_state": {"const": "STUDENT_READY"},
    "runtime_mode": {"type": "string", "minLength": 1},
    "pod_id": {"type": "string", "pattern": "^pod-0[1-5]$"},
    "track": {"enum": ["SOC", "PENTEST", "SUPPORT"]},
    "assignment_id": {"type": "string", "minLength": 1},
    "resources": {"type": "object"}
  },
  "additionalProperties": true
}
