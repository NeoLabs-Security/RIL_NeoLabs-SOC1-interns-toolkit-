#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if ! command -v python3 >/dev/null 2>&1; then
  printf 'ERROR: python3 is required for the NeoLabs CLI. Run `bash start-neolabs-soc.sh` first so the supported runtime can be prepared.\n' >&2
  exit 2
fi

exec python3 -m tools.cli "$@"
