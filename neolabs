#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  printf 'ERROR: python3 is required for the NeoLabs CLI. Run `bash start-neolabs-soc.sh` first so the supported runtime can be prepared.\n' >&2
  exit 2
fi

# Preserve the caller's directory for relative local evidence paths.
if [[ "${1:-}" == "offline" && ( "${2:-}" == "analyze" || "${2:-}" == "import" ) ]]; then
  exec python3 "$ROOT_DIR/tools/cli.py" "$@"
fi

cd "$ROOT_DIR"

# The root CLI is also a supported stack-entry path (`bash neolabs connect`).
# Propagate the same host profile used by the full launcher so Wazuh dashboard
# exposure/preflight cannot disagree with a previous launcher run. Treat WSL as
# the Windows workstation profile even when this wrapper is invoked from Bash.
if grep -qiE '(microsoft|wsl)' /proc/sys/kernel/osrelease 2>/dev/null; then
  export NEOLABS_HOST_MODE=windows
else
  export NEOLABS_HOST_MODE=linux
fi

# Direct SOC CLI commands may be invoked from the original SSH shell after
# first-run AutoFix grants Docker access. That parent shell retains its stale
# groups; refresh only Docker-using NeoLabs commands in an authorized child.
# The full Linux launcher already refreshes its own Docker-using process.
# W05 central SOC commands do not need Docker permissions. A saved session
# is only a routing hint; the broker remains authoritative inside tools.cli.
if [[ "${1:-}" == connect || "${1:-}" == doctor ]] &&
   python3 -m tools.week05_central; then
  exec python3 -m tools.cli "$@"
fi

case "${1:-}" in
  connect|doctor|arena|disconnect|ip-blacklist|ip-watchlist)
    if [[ "$NEOLABS_HOST_MODE" == linux ]]; then
      exec bash internal/linux/With-DockerAccess.sh python3 -m tools.cli "$@"
    fi
    ;;
esac

exec python3 -m tools.cli "$@"
